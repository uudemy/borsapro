{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=trading_db;Username=trading_user;Password=trading_password",
    "RedisConnection": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "TradingApp",
    "Audience": "TradingAppUsers",
    "Key": "SuperSecretKeyForDevelopmentOnly_MakeSureToChangeThis"
  }
}
