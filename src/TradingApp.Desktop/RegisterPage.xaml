<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TradingApp.Desktop.RegisterPage"
             BackgroundColor="#121212"
             Title="Kayıt Ol">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center" HorizontalOptions="Center" MaximumWidthRequest="400">
            
            <Label Text="🚀 PRO Borsa" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White" />
            <Label Text="Yeni Hesap Oluştur" FontSize="18" TextColor="#A0A0A0" HorizontalOptions="Center" Margin="0,0,0,20" />

            <Entry x:Name="FirstNameEntry" Placeholder="Adınız" TextColor="White" BackgroundColor="#1E1E24" PlaceholderColor="#A0A0A0" />
            <Entry x:Name="LastNameEntry" Placeholder="Soyadınız" TextColor="White" BackgroundColor="#1E1E24" PlaceholderColor="#A0A0A0" />
            <Entry x:Name="EmailEntry" Placeholder="E-posta Adresi" Keyboard="Email" TextColor="White" BackgroundColor="#1E1E24" PlaceholderColor="#A0A0A0" />
            <Entry x:Name="PasswordEntry" Placeholder="Şifre" IsPassword="True" TextColor="White" BackgroundColor="#1E1E24" PlaceholderColor="#A0A0A0" />

            <Button x:Name="RegisterButton" Text="Kayıt Ol" Clicked="OnRegisterClicked" BackgroundColor="#512BD4" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="50" Margin="0,10,0,0"/>

            <Label x:Name="ResultLabel" TextColor="Red" HorizontalOptions="Center" />

            <Button Text="Giriş Sayfasına Dön" Clicked="OnBackToLoginClicked" BackgroundColor="Transparent" TextColor="#00C853" FontAttributes="Bold" Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
