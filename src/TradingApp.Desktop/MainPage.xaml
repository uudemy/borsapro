<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TradingApp.Desktop.MainPage"
             BackgroundColor="#1E1E24">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30,50" VerticalOptions="Center" MaximumWidthRequest="400">
            
            <Label Text="Borsa Platformu" FontSize="32" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
            <Label Text="Hesabınıza giriş yapın" FontSize="16" TextColor="#A0A0A0" HorizontalOptions="Center" Margin="0,0,0,20"/>

            <Entry x:Name="EmailEntry" Placeholder="E-Posta" Keyboard="Email" TextColor="White" PlaceholderColor="#A0A0A0" BackgroundColor="#2B2B36" Padding="15,10" />
            
            <Entry x:Name="PasswordEntry" Placeholder="Şifre" IsPassword="True" TextColor="White" PlaceholderColor="#A0A0A0" BackgroundColor="#2B2B36" Padding="15,10" />

            <Button Text="Giriş Yap" Clicked="OnLoginClicked" BackgroundColor="#007BFF" TextColor="White" FontAttributes="Bold" CornerRadius="8" Padding="15" Margin="0,20,0,0"/>

            <Label x:Name="ResultLabel" TextColor="#FF4C4C" HorizontalOptions="Center" Margin="0,10,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
